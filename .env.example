# 复制为 .env 后填入真实值；.env 已在 .gitignore 中，不会被提交。
# 只写变量名与示例值，任何真实密钥都不要出现在这个文件里。

# ---------- 模型（任选一家 OpenAI 兼容端点） ----------

# 方式一：本地模型（llama.cpp / vLLM / LM Studio / Ollama 均可）
# 本地端点通常不校验密钥，SAFEGUARD_LLM_API_KEY 可以留空——
# 适配层只在 key 非空时才发送 Authorization 头。
SAFEGUARD_LLM_BASE_URL=http://127.0.0.1:8080/v1
SAFEGUARD_LLM_API_KEY=
SAFEGUARD_LLM_MODEL=your-model-name
# 本地模型首次调用要加载权重、思考型模型还要生成思维链，超时给宽一点
SAFEGUARD_LLM_TIMEOUT=180s

# 备用模型端点（可选）：base_url|model|api_key，多个用 ; 分隔
# 配置后自动启用"健康监控 + 失败切换"；不配就是单端点。
# SAFEGUARD_LLM_FALLBACKS=http://127.0.0.1:8081/v1|qwen2.5-7b|
# 连续失败多少次判定端点不健康（默认 3）
# SAFEGUARD_LLM_FAIL_THRESHOLD=3
# 判定不健康后的冷却时间（默认 30s）；冷却到期放一次试探
# SAFEGUARD_LLM_COOLDOWN=30s

# 方式二：云端 API（换模型只改这三行，业务代码零改动）
# SAFEGUARD_LLM_BASE_URL=https://api.deepseek.com/v1
# SAFEGUARD_LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SAFEGUARD_LLM_MODEL=deepseek-chat
# SAFEGUARD_LLM_TIMEOUT=60s

# ---------- 数据库（MySQL 8.0.16+） ----------
# 格式：[user[:password]@][tcp(host:port)]/dbname?参数
#
# 应用会自动补齐这些参数，不需要手写：
#   parseTime=true        读回来直接是 time.Time
#   loc=UTC / time_zone='+00:00'   时间语义统一按 UTC
#   timeout=5s            建连超时，避免网络黑洞把启动挂死
#   tls=preferred         MySQL 8 默认 caching_sha2_password，服务端缓存未命中时
#                         需要 full auth；明文连接要依赖服务器下发 RSA 公钥，
#                         有些服务器（实测 MySQL 8.0.32）不下发，表现就是
#                         "密码没错却一直 Access denied"。开了 TLS 就绕开了。
#   multiStatements       按连接用途钉死：迁移连接开、主连接池永久关闭
#
# 密码里含 @ 也没问题：分隔符取地址前的"最后一个 @"，且应用不会对密码做 URL 转义。
# 想强制加密可显式写 ?tls=skip-verify（自签证书场景）。
SAFEGUARD_DB_DSN=appuser:your-password@tcp(127.0.0.1:3306)/appdb
SAFEGUARD_DB_MAX_OPEN_CONNS=10
SAFEGUARD_DB_MAX_IDLE_CONNS=5
SAFEGUARD_DB_CONN_MAX_LIFETIME=30m

# ---------- 日志 ----------
SAFEGUARD_LOG_LEVEL=info
